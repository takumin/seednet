{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:best-practices",
		"github>aquaproj/aqua-renovate-config#2.13.0",
		"github>aquaproj/aqua-renovate-config:file#2.13.0(.aqua/.*\\.ya?ml)",
		"github>aquaproj/aqua-renovate-config:file#2.13.0(.aqua/pkgs/.*\\.ya?ml)"
	],
	"timezone": "Asia/Tokyo",
	"automerge": true,
	"customManagers": [
		{
			"customType": "regex",
			"description": "Keep the MSRV in step with the pinned toolchain in rust-toolchain.toml",
			"managerFilePatterns": ["/(^|/)Cargo\\.toml$/"],
			"matchStrings": ["\\nrust-version = \"(?<currentValue>\\d+\\.\\d+)\""],
			"depNameTemplate": "rust",
			"datasourceTemplate": "rust-version",
			"versioningTemplate": "rust-release-channel",
			"depTypeTemplate": "msrv"
		}
	],
	"packageRules": [
		{
			"description": "Keep the releases of the end-to-end guests, such as Rocky Linux 9 and 10 apart, and take only their digests and minor updates",
			"matchFileNames": ["e2e/Containerfile.*"],
			"matchDatasources": ["docker"],
			"matchUpdateTypes": ["major"],
			"enabled": false
		},
		{
			"description": "Keep the Ubuntu guest on a long-term support release, not one of the releases in between",
			"matchFileNames": ["e2e/Containerfile.*"],
			"matchDatasources": ["docker"],
			"matchDepNames": ["docker.io/library/ubuntu", "ubuntu"],
			"allowedVersions": "/^\\d+\\.04$/"
		},
		{
			"description": "Update the toolchain pin and the MSRV in one PR",
			"matchDatasources": ["rust-version"],
			"matchDepNames": ["rust"],
			"groupName": "rust"
		}
	]
}
