root = true

[*]
charset                  = utf-8
end_of_line              = lf
indent_style             = tab
indent_size              = 2
insert_final_newline     = true
trim_trailing_whitespace = true

[*.{sh,bash}]
switch_case_indent = true
space_redirects    = true
binary_next_line   = true
function_next_line = true

[*.{yaml,yml}]
indent_style = space

[*.toml]
indent_style = space

[{Containerfile,Dockerfile}{,.*}]
indent_style = space

# The cloud-init files of the end-to-end tests, which are YAML without the extension.
[e2e/{network-config,meta-data,user-data}]
indent_style = space

[*.rs]
max_line_length = 100
indent_style    = space
indent_size     = 4

[*.py]
max_line_length = 100
indent_style    = space
indent_size     = 4

[{LICENSE,*.md}]
indent_style = unset
