#!/bin/sh
# Brings up the network of the rootfs from the NoCloud network-config, as seednet.service runs it.
set -eu

# The backend of the initrd, before seednet writes the one of the rootfs over it.
initrd_backend=$(cat /run/seednet/backend 2>/dev/null || true)

seednet --backend auto apply --stage rootfs --takeover

# The catch-all DHCP of dracut 110 and later, which it leaves in /run even where seednet did not
# bring up the network of the initrd, is for when nothing says how the network is.
if [ -e /run/seednet/source ]; then
	rm -f /run/systemd/network/zzzz-dracut-default.network
fi

# Rename the interfaces that the .link files say, before anything brings them up. udevd reads new
# .link files only every few seconds, so tell it to.
udevadm control --reload
udevadm trigger --action=add --subsystem-match=net
udevadm settle

# NetworkManager cannot change a bond that has ports, and may take a bridge or a VLAN it finds for
# an external connection, so it gets the ones that the networkd of the initrd made afresh, unless
# the rootfs is on the network over them. VLANs go first, then bridges, then bonds, so that what goes
# is never under something still there. What the NetworkManager of an initrd made, NetworkManager
# takes over itself, and would not bring the ports of a bond made afresh into it.
rootfs_backend=$(cat /run/seednet/backend 2>/dev/null || true)
if [ "$rootfs_backend" = network-manager ] &&
	[ "$initrd_backend" != network-manager ] &&
	[ ! -e /run/seednet/network-rootfs ]; then
	for dev in /proc/net/vlan/* /sys/class/net/*/bridge /sys/class/net/*/bonding; do
		[ -e "$dev" ] && [ "$dev" != /proc/net/vlan/config ] || continue
		case $dev in
		/proc/net/vlan/*) name=${dev##*/} ;;
		*)
			name=${dev%/*}
			name=${name##*/}
			;;
		esac
		ip link delete "$name"
	done
fi

# networkd takes over what the NetworkManager of the initrd made, but for the IPv6 link-local
# address of the MAC address that NetworkManager gave a bridge or a bond, which stays when networkd
# gives it another, and so goes, for networkd to give the one of its own.
if [ "$rootfs_backend" = networkd ] &&
	[ "$initrd_backend" = network-manager ] &&
	[ ! -e /run/seednet/network-rootfs ]; then
	for dev in /sys/class/net/*/bridge /sys/class/net/*/bonding; do
		[ -e "$dev" ] || continue
		name=${dev%/*}
		ip -6 address flush dev "${name##*/}" scope link
	done
fi
