# The guests of the end-to-end tests on Fedora and Enterprise Linux: cloud-init, seednet in a dracut
# initrd with systemd-networkd or NetworkManager, whichever the rootfs has, and SELinux enforcing.
# Enterprise Linux has NetworkManager only, as systemd-networkd is not in its repositories.
ARG DISTRO=fedora

FROM registry.fedoraproject.org/fedora:44@sha256:3988086adef2975a8a3a6c15634e21625efebc6ac043c83f02f619efff6c5d11 AS fedora
FROM quay.io/rockylinux/rockylinux:9@sha256:8101994123cf3d0a8fee517bee7f39e555c7d92bd2d9eb3303cc988a0eeed00f AS el9
FROM quay.io/almalinuxorg/almalinux:10@sha256:96336c2e1a61ba389a943ca68069ea803ccfabe12c4461a6e869496ddc9cad8e AS el10

# hadolint ignore=DL3006
FROM ${DISTRO}

ARG BACKEND=networkd

# A mirror in place of the mirror list, as e2e/run.sh takes it from E2E_MIRROR_<DISTRO>: where the
# repositories of the distribution are, in place of the URL of the commented baseurl lines.
ARG MIRROR=
RUN . /etc/os-release \
  && [ -n "$MIRROR" ] || exit 0 \
  && case $ID in \
    fedora) default=http://download.example/pub/fedora/linux ;; \
    rocky) default='http://dl.rockylinux.org/\$contentdir' ;; \
    almalinux) default=https://repo.almalinux.org/almalinux ;; \
  esac \
  && for repo in /etc/yum.repos.d/*.repo; do \
    grep -q "^# *baseurl=$default/" "$repo" || continue; \
    sed -i -E -e 's/^(metalink|mirrorlist)=/#&/' -e "s|^# *baseurl=$default/|baseurl=${MIRROR%/}/|" "$repo"; \
  done

# The live rootfs needs squashfs, which Enterprise Linux 10 has in kernel-modules only. curl is
# curl-minimal on Enterprise Linux 9, which the full one conflicts with.
# networkctl edit needs a terminal from script, which Fedora has apart from util-linux, and D-Bus.
# Fedora has systemd-resolved, as it does by default, and the initrd resolves host names with it;
# with NetworkManager alone, as on Enterprise Linux, NetworkManager writes /etc/resolv.conf.
RUN . /etc/os-release \
  && if [ "$BACKEND" = nm ]; then packages=NetworkManager; else packages="systemd-networkd util-linux-script"; fi \
  && if [ "$ID" = fedora ]; then packages="$packages systemd-resolved"; fi \
  && dnf -y install --setopt=install_weak_deps=False \
    systemd systemd-udev dbus-broker kmod iproute procps-ng findutils kernel-core cloud-init \
    dracut dracut-network dracut-live /usr/bin/curl ca-certificates \
    selinux-policy-targeted libselinux-utils python3-libselinux $packages \
  && if ! modinfo -k "$(ls /lib/modules)" squashfs > /dev/null 2>&1; then \
    dnf -y install --setopt=install_weak_deps=False kernel-modules; \
  fi \
  && dnf clean all

# NetworkManager comes with dracut-network on Fedora, enabled, so it is disabled for networkd.
RUN if [ "$BACKEND" = nm ]; then \
      systemctl enable NetworkManager; \
    else \
      systemctl enable systemd-networkd; \
      if [ -e /usr/lib/systemd/system/NetworkManager.service ]; then systemctl disable NetworkManager; fi; \
    fi \
  && if [ -e /usr/lib/systemd/system/systemd-resolved.service ]; then systemctl enable systemd-resolved; fi

# The release build of seednet for the architecture of the host.
ARG SEEDNET=target/x86_64-unknown-linux-musl/release/seednet
COPY ${SEEDNET} /usr/bin/seednet
COPY contrib/dracut/95seednet /usr/lib/dracut/modules.d/95seednet
COPY contrib/systemd/seednet-rootfs /usr/libexec/seednet-rootfs
COPY contrib/systemd/seednet.service /usr/lib/systemd/system/seednet.service
COPY e2e/guest/check.sh /usr/local/bin/e2e-check
COPY e2e/guest/editor.sh /usr/local/bin/e2e-editor
COPY e2e/guest/e2e-check.service /usr/lib/systemd/system/e2e-check.service

# The CA of the HTTPS server of the tests, in the CA bundle that the initrd gets.
COPY --from=tls ca.crt /etc/pki/ca-trust/source/anchors/seednet-e2e.crt
RUN update-ca-trust

# The initrd has the backend of the rootfs: dracut would take NetworkManager whenever it is there.
RUN if [ "$BACKEND" = nm ]; then add=network-manager omit=systemd-networkd; else add=systemd-networkd omit=network-manager; fi \
  && systemctl enable seednet.service e2e-check.service \
  && kver=$(ls /lib/modules) \
  && mkdir -p /boot && cp "/lib/modules/$kver/vmlinuz" /boot/vmlinuz.seednet \
  && dracut --force --no-hostonly --add "seednet dmsquash-live livenet $add" \
      --omit "$omit" --kver "$kver" /boot/initrd.seednet.img

# Last, so that the labels are of every file.
RUN --mount=type=bind,source=e2e/guest/labels.py,target=/tmp/labels.py \
  python3 -I /tmp/labels.py > /.e2e-labels
